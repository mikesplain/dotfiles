[github]
	user = mikesplain
[user]
	# Name used in commit messages.
	name = Mike Splain
	# Email used in commit messages.
	email = msplain@cisco.com
	# Signing key is resolved live from the 1Password agent (label: work). No key
	# material is stored here, so rotating the key in 1Password is all that's needed.

[gpg]
	format = ssh

[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
	defaultKeyCommand = 1pw-sign work

[commit]
	gpgsign = true
